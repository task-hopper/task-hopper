# hop shell integration
# Copy this file to your shell config (e.g. ~/.bashrc or ~/.zshrc) and source it.
#
# By default, hop uses whatever 'hop' binary is found in PATH.
# If you need to point to a specific binary, set HOP_BIN before sourcing:
#   export HOP_BIN=~/.hop/venv/bin/hop

_hop_bin() {
    echo "${HOP_BIN:-$(command -v hop)}"
}

# Process a stream of hop directives, evaluating tasks in the current shell context.
_hop_process_output() {
    local YELLOW='\033[0;33m'
    local RED='\033[0;31m'
    local RESET='\033[0m'

    while IFS= read -r line; do
        case "$line" in
            __hop_task__:*)    eval "${line#__hop_task__:}" ;;
            __hop_message__:*) echo "${line#__hop_message__:}" ;;
            __hop_warning__:*) echo -e "${YELLOW}${line#__hop_warning__:}${RESET}" ;;
            __hop_error__:*)   echo -e "${RED}${line#__hop_error__:}${RESET}"; return 1 ;;
            *)                 ;;
        esac
    done
}

# Main hop function — runs the Python process and processes its output.
hop() {
    "$(_hop_bin)" "$@" | _hop_process_output
}

# Debug mode — shows raw output first, then replays through the directive processor.
hopd() {
    local output
    output="$("$(_hop_bin)" "$@")"
    echo "=== raw output ==="
    echo "$output"
    echo "=== executing ==="
    echo "$output" | _hop_process_output
}

# Bash completion
_hop_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local prev="${COMP_WORDS[COMP_CWORD-1]}"
    local subcommands
    subcommands="$("$(_hop_bin)" --help 2>/dev/null | awk '/Commands/{found=1; next} found && /^  [a-z]/{print $1}')"

    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
    fi
}

complete -F _hop_complete hop
