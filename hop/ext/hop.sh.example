# hop shell integration
# Copy this file to your shell config (e.g. ~/.bashrc or ~/.zshrc) and source it.
#
# By default, hop uses whatever 'hop' binary is found in PATH.
# If you need to point to a specific binary, set HOP_BIN before sourcing:
#   export HOP_BIN=~/.hop/venv/bin/hop

_hop_bin() {
    echo "${HOP_BIN:-$(command -v hop)}"
}

# Process a stream of hop directives, evaluating tasks in the current shell context.
# Takes the output string as $1 and reads it on fd 3, leaving fd 0 (stdin) as the
# terminal so that long-running task commands (dev servers, etc.) inherit it correctly.
_hop_process_output() {
    local YELLOW='\033[0;33m'
    local RED='\033[0;31m'
    local RESET='\033[0m'

    while IFS= read -r line <&3; do
        case "$line" in
            __hop_task__:*)    eval "${line#__hop_task__:}" ;;
            __hop_message__:*) echo "${line#__hop_message__:}" ;;
            __hop_warning__:*) echo -e "${YELLOW}${line#__hop_warning__:}${RESET}" ;;
            __hop_error__:*)   echo -e "${RED}${line#__hop_error__:}${RESET}"; return 1 ;;
            *)                 echo "$line" ;;
        esac
    done 3<<< "$1"
}

# Main hop function — runs the Python process and processes its output.
# Output is captured first so _hop_process_output runs in the current shell
# context (not a subshell), which allows directives like `cd` to take effect.
hop() {
    local output
    output="$(FORCE_COLOR=1 HOP_SHELL_INVOCATION=1 "$(_hop_bin)" "$@")"
    _hop_process_output "$output"
}

# Debug mode — shows raw output first, then replays through the directive processor.
hopd() {
    local output
    output="$(FORCE_COLOR=1 HOP_SHELL_INVOCATION=1 "$(_hop_bin)" "$@")"
    echo "=== raw output ==="
    echo "$output"
    echo "=== executing ==="
    _hop_process_output "$output"
}

# Bash completion — delegates to Click/Typer's native completion protocol,
# calling the binary directly to bypass the shell function wrapper.
_hop_completion() {
    local IFS=$'\n'
    COMPREPLY=( $( env COMP_WORDS="${COMP_WORDS[*]}" \
                   COMP_CWORD=$COMP_CWORD \
                   _HOP_COMPLETE=complete_bash "$(_hop_bin)" ) )
    return 0
}

complete -o default -F _hop_completion hop
